# Copy to terraform.tfvars and fill in secrets. Do not commit terraform.tfvars.
#
# Authentication options:
#
# 1. Environment variables (recommended for CI and local deploy):
#    export DIGITALOCEAN_TOKEN="dop_v1_..."
#    export TF_VAR_inference_api_key="your-inference-api-key"
#    # do_token can stay null; the DigitalOcean provider reads DIGITALOCEAN_TOKEN
#
# 2. Explicit Terraform variables:
#    do_token           = "dop_v1_..."
#    inference_api_key  = "your-inference-api-key"
#
# 3. doctl (used by scripts/deploy.sh to verify credentials):
#    doctl auth init -t "$DIGITALOCEAN_TOKEN"
#    doctl account get

environment = "dev"
region      = "nyc3"
image_tag   = "latest"

# do_token          = "dop_v1_..."
# inference_api_key = "your-inference-api-key"

# Optional overrides:
# primary_model   = "meta-llama/Meta-Llama-3.1-8B-Instruct"
# candidate_model = "meta-llama/Meta-Llama-3.1-8B-Instruct"
