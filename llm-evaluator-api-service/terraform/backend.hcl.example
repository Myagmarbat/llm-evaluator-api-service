# Remote state backend for DigitalOcean Spaces (S3-compatible).
#
# One-time setup:
#   1. Create a Spaces bucket (see terraform/bootstrap/).
#   2. In versions.tf, replace the local backend block with:
#        backend "s3" {}
#   3. Copy this file to backend.hcl and fill in values.
#   4. Run: terraform init -reconfigure -backend-config=backend.hcl
#
# CI/CD: when TF_STATE_BUCKET is configured, the CD workflow generates
# backend.hcl from secrets and runs terraform init with this file.

bucket                      = "your-tfstate-bucket-name"
key                         = "llm-evaluator-api-service/dev/terraform.tfstate"
region                      = "nyc3"
endpoint                    = "https://nyc3.digitaloceanspaces.com"
access_key                  = "YOUR_SPACES_ACCESS_KEY"
secret_key                  = "YOUR_SPACES_SECRET_KEY"
skip_credentials_validation = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_requesting_account_id  = true
